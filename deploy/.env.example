# Copy to .env and fill in.

# Domain pointing at the server (Caddy gets the TLS cert), or ":80" for a plain-HTTP test.
SITE_ADDRESS=scrape.example.com

# Shared secret. Your bot sends this as the Firecrawl "API key".
# Generate with: openssl rand -hex 32
API_TOKEN=

# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
POSTGRES_PASSWORD=

# Pin these to an exact release once the stack is proven.
FIRECRAWL_TAG=latest
PLAYWRIGHT_TAG=latest
NUQ_POSTGRES_TAG=latest

# Tuning. Defaults suit 8 vCPU / 16 GB.
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
API_MEM_LIMIT=8g
PLAYWRIGHT_MEM_LIMIT=4g
BLOCK_MEDIA=true

# Optional: LLM for JSON extraction.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# Optional: outbound proxy for sites that block datacenter IPs.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
